          this.pagePromises[pageIndex].resolve(page);

        } else { // must be a child page dictionary
          assert(
            isDict(kid),
            'page dictionary kid reference points to wrong type of object'
          );

          queue.push({
            pagesDict: kid,
            posInKids: 0
